# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development
DEPLOYMENT_STAGE=development
PORT=4000
POSTGRES_DB=commerce
POSTGRES_USER=commerce
POSTGRES_PASSWORD=replace-with-a-strong-database-bootstrap-password
APP_DB_USER=commerce_app
APP_DB_PASSWORD=replace-with-a-different-strong-application-password
DATABASE_URL=postgresql://commerce:commerce_local_only@localhost:5432/commerce?schema=public

PUBLIC_APP_URL=http://localhost:5173
PUBLIC_ADMIN_URL=http://localhost:5174
PUBLIC_APP_DOMAIN=example.com
PUBLIC_ADMIN_DOMAIN=admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_SECRET=replace-with-at-least-32-random-bytes
OTP_PEPPER=replace-with-a-separate-random-secret
CSRF_SECRET=replace-with-a-separate-random-secret
SESSION_TTL_HOURS=24
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_PRESIGN_TTL_SECONDS=180
R2_UPLOADS_ENABLED=false
MAX_UPLOAD_BYTES=52428800

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2026-01-01
PAYMENTS_ENABLED=false

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_SUPPORT_EMAIL=
BUSINESS_SUPPORT_PHONE=
BUSINESS_GSTIN=
DEFAULT_CURRENCY=INR
DEFAULT_SHIPPING_FLAT_RATE_PAISE=0
FREE_SHIPPING_THRESHOLD_PAISE=
DEFAULT_TAX_MODE=EXCLUSIVE
SHIPPING_TAX_RATE_BPS=
SHIPPING_TAX_CODE=
SHIPPING_TAX_EFFECTIVE_FROM=
