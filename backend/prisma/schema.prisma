generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum AssetStatus {
  PENDING
  UPLOADED
  QUARANTINED
  APPROVED
  REJECTED
  DELETED
}
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  CANCELLATION_REQUESTED
  CANCELLED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}
enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}
enum CustomPrintStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_CLARIFICATION
  QUOTED
  ACCEPTED
  DECLINED
  REJECTED
  CONVERTED_TO_ORDER
  CANCELLED
}
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
}
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum TaxMode {
  INCLUSIVE
  EXCLUSIVE
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  role            UserRole      @default(CUSTOMER)
  emailVerifiedAt DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        Session[]
  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  otpChallenges   OtpChallenge[]
  resetChallenges PasswordResetChallenge[]
  customRequests  CustomPrintRequest[]
  uploadedAssets  UploadedAsset[]
  auditEvents     AuditLog[]    @relation("AuditActor")
  contentEdits    ContentRevision[] @relation("ContentEditor")
  @@index([role, isActive])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  csrfHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model OtpChallenge {
  id            String   @id @default(cuid())
  userId        String
  purpose       String   @default("EMAIL_VERIFY")
  digest        String
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose, expiresAt])
}

model PasswordResetChallenge {
  id          String   @id @default(cuid())
  userId      String
  digest      String   @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Address {
  id              String   @id @default(cuid())
  userId          String
  label           String?
  fullName        String
  phone           String
  line1           String
  line2           String?
  locality        String
  city            String
  state           String
  pinCode         String
  deliveryNotes   String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isDefault])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  @@index([parentId, sortOrder])
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  sku                String        @unique
  description        String
  categoryId         String?
  basePricePaise     Int
  salePricePaise     Int?
  currency           String        @default("INR")
  dimensionsMm       Json?
  weightGrams        Int?
  leadTimeDays       Int            @default(3)
  status             ProductStatus  @default(DRAFT)
  seoTitle           String?
  seoDescription     String?
  taxCode            String?
  taxConfig          Json?
  shippingConfig     Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  category           Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  variants           ProductVariant[]
  orderItems         OrderItem[]
  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([basePricePaise])
  @@index([name])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  objectKey String   @unique
  altText   String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, sortOrder])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  sku             String   @unique
  name            String
  material        String?
  color           String?
  pricePaise      Int
  salePricePaise  Int?
  stockQuantity   Int      @default(0)
  reservedQuantity Int     @default(0)
  isActive        Boolean  @default(true)
  attributes      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements       InventoryMovement[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  @@index([productId, isActive])
  @@index([stockQuantity, reservedQuantity])
}

model InventoryMovement {
  id           String   @id @default(cuid())
  variantId    String
  delta        Int
  reason       String
  referenceType String?
  referenceId  String?
  actorUserId  String?
  createdAt    DateTime @default(now())
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  guestKey  String?    @unique
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  userId               String
  status               OrderStatus @default(PENDING_PAYMENT)
  currency             String      @default("INR")
  subtotalPaise        Int
  shippingPaise        Int
  discountPaise        Int      @default(0)
  taxPaise             Int
  totalPaise           Int
  taxMode              TaxMode
  taxBreakdown         Json
  shippingAddressSnapshot Json
  billingAddressSnapshot Json?
  idempotencyKey       String?
  customerNote         String?
  paidAt               DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  payments             PaymentAttempt[]
  refunds              Refund[]
  shipments            Shipment[]
  customPrintRequest   CustomPrintRequest?
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String?
  variantId           String?
  productNameSnapshot String
  skuSnapshot         String
  variantSnapshot     Json
  unitPricePaise      Int
  quantity            Int
  taxPaise            Int
  lineTotalPaise      Int
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model PaymentAttempt {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus @default(CREATED)
  amountPaise       Int
  currency          String        @default("INR")
  idempotencyKey    String        @unique
  providerMetadata  Json?
  failureCode       String?
  failureMessage    String?
  verifiedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhooks          PaymentWebhookEvent[]
  refunds           Refund[]
  @@index([orderId, createdAt])
  @@index([provider, providerOrderId])
  @@index([provider, providerPaymentId])
}

model PaymentWebhookEvent {
  id             String   @id @default(cuid())
  provider       String
  providerEventId String
  eventType      String
  payloadDigest  String
  verified       Boolean  @default(false)
  processedAt    DateTime?
  processingError String?
  paymentAttemptId String?
  receivedAt     DateTime @default(now())
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  @@unique([provider, providerEventId])
  @@index([verified, processedAt])
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  paymentAttemptId String?
  providerRefundId String?
  amountPaise      Int
  status           String
  reason           String?
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  @@index([orderId, createdAt])
}

model Shipment {
  id                String   @id @default(cuid())
  orderId           String
  carrier           String?
  trackingNumber    String?
  trackingUrl       String?
  status            String   @default("PENDING")
  shippedAt         DateTime?
  deliveredAt       DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId, status])
}

model CustomPrintRequest {
  id              String @id @default(cuid())
  reference        String @unique
  userId           String
  status           CustomPrintStatus @default(SUBMITTED)
  material         String?
  color            String?
  quantity         Int @default(1)
  dimensionsMm     Json?
  instructions     String?
  desiredBy        DateTime?
  adminNotes       String?
  rejectionReason  String?
  orderId          String? @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User @relation(fields: [userId], references: [id], onDelete: Restrict)
  order            Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  files            CustomPrintFile[]
  quotations       Quotation[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CustomPrintFile {
  id          String @id @default(cuid())
  requestId   String
  assetId     String @unique
  label       String?
  createdAt   DateTime @default(now())
  request     CustomPrintRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  asset       UploadedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@index([requestId])
}

model Quotation {
  id               String @id @default(cuid())
  requestId        String
  revision         Int
  status           QuoteStatus @default(DRAFT)
  subtotalPaise    Int
  shippingPaise    Int
  taxPaise         Int
  totalPaise       Int
  currency         String @default("INR")
  leadTimeDays     Int
  terms            String?
  expiresAt        DateTime?
  sentAt           DateTime?
  acceptedAt       DateTime?
  declinedAt       DateTime?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  request          CustomPrintRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  @@unique([requestId, revision])
  @@index([requestId, status])
}

model UploadedAsset {
  id            String @id @default(cuid())
  ownerUserId   String
  objectKey     String @unique
  originalName  String
  contentType   String
  sizeBytes     Int
  bucketName    String
  checksumSha256 String?
  status        AssetStatus @default(PENDING)
  purpose       String
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  owner         User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  customPrintFile CustomPrintFile?
  @@index([ownerUserId, status, createdAt])
  @@index([status, expiresAt])
}

model ContentPage {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  body        String
  status      ContentStatus @default(DRAFT)
  isRequired  Boolean @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revisions   ContentRevision[]
  @@index([status, slug])
}

model ContentRevision {
  id          String @id @default(cuid())
  pageId      String
  editorId    String?
  title       String
  body        String
  status      ContentStatus
  changeNote  String?
  createdAt   DateTime @default(now())
  page        ContentPage @relation(fields: [pageId], references: [id], onDelete: Restrict)
  editor      User? @relation("ContentEditor", fields: [editorId], references: [id], onDelete: SetNull)
  @@index([pageId, createdAt])
}

model AuditLog {
  id          String @id @default(cuid())
  actorUserId String?
  action      String
  resource    String
  resourceId  String?
  requestId   String?
  ipHash      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resource, resourceId])
}

model IdempotencyRecord {
  id          String @id @default(cuid())
  scope       String
  key         String
  requestHash String
  response    Json?
  statusCode  Int?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  @@unique([scope, key])
  @@index([expiresAt])
}
